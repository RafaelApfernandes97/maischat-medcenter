# Copie para .env e preencha. Nao versione o .env.

# Base da API do Mais Chat
MAISCHAT_API_BASE=https://api.maischat.io/v3

# Template do WhatsApp a ser disparado (deve existir e estar aprovado).
TEMPLATE_NAME=confirmacao_consulta
TEMPLATE_LANG=pt_BR

# Autenticacao da plataforma (a API key / bearer que voce possui).
# Ex.: MAISCHAT_AUTH=Bearer eyJ...
MAISCHAT_AUTH=

# Canal 0800 - Cloud (defaults ja apontam para este canal)
BROKER_APP_ID=238057352730277
BROKER_SOURCE=558000708000
BROKER_TOKEN=

# Modo simulado: nao envia mensagens reais (true/false). Use true para testar o fluxo.
DRY_RUN=true

PORT=3000

# Banco PostgreSQL para o historico de lotes/envios
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=disable
